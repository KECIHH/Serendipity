  "cases": [
    {
      "testCaseId": "Phase015:schema-bootstrap",
      "command": "npm run test -- ai-governance",
      "denominator": 1,
      "inputPath": "prisma/schema.prisma",
      "outputPath": "docs/evidence/attempts/Phase015/attempt-12/schema-bootstrap.json",
      "expected": "An empty Phase014 database migrates additively to exactly 8 prompt definitions and version-1 prompts, one MOCK provider config version, one mock model deployment, 8 prompt activations, 8 disabled prompt-model activations, one immutable planning policy version and active pointer, and ai.calls.enabled=false. Bootstrap is idempotent with zero immutable-row updates. Temporary PromptConfig/AiModelConfig tables remain absent."
    },
    {
      "testCaseId": "Phase015:resolution",
      "command": "npm run test -- prompt-service model-resolution",
      "denominator": 1,
      "inputPath": "src/server/services/prompt-service.ts",
      "outputPath": "docs/evidence/attempts/Phase015/attempt-12/resolution.json",
      "expected": "A consistent snapshot resolves exact prompt, model, and provider versions. Missing pointers, cross-definition/version references, content hash drift, disabled tuples, schema/capability mismatch, unknown or missing variables, and disabled required secrets return CONFIG_ERROR with zero adapter calls. Atomic tuple activation increments both pointer revisions together or not at all."
    },
    {
      "testCaseId": "Phase015:isolation-ssrf",
      "command": "npm run test -- provider-registry isolation",
      "denominator": 1,
      "inputPath": "src/server/ai/provider-registry.ts",
      "outputPath": "docs/evidence/attempts/Phase015/attempt-12/isolation-ssrf.json",
      "expected": "Only server-only adapter files may import provider transports. Business import scans find zero direct SDK/provider fetch usage. HTTPS, hostname allowlist, port, DNS private/link-local/loopback rejection, per-redirect revalidation with a two-hop maximum, and response-size limits reject unsafe targets without secret disclosure."
    },
    {
      "testCaseId": "Phase015:timeout-cancel-retry",
      "command": "npm run test -- guarded-client timeout",
      "denominator": 1,
      "inputPath": "src/server/ai/guarded-client.ts",
      "outputPath": "docs/evidence/attempts/Phase015/attempt-12/timeout-cancel-retry.json",
      "expected": "A shared total deadline and AbortSignal stop work and mark the correct state. A retry occurs only before any response byte for explicit connect/429/5xx errors, at most once, with injected jitter/Retry-After and a shared budget. First-byte, cancellation, schema, 4xx, configuration, and cost failures do not retry."
    },
    {
      "testCaseId": "Phase015:quota-cost",
      "command": "npm run test -- guarded-client quota",
      "denominator": 1,
      "inputPath": "src/server/ai/guarded-client.ts",
      "outputPath": "docs/evidence/attempts/Phase015/attempt-12/quota-cost.json",
      "expected": "Durable reservations use atomic buckets and Decimal conservative upper bounds. Concurrent calls never exceed token/cost hard caps. NOT_SENT releases are idempotent; submission is atomically marked MAY_HAVE_BEEN_SENT before transport. Unknown, cancelled, timed-out, and lost-response reservations enter RECONCILING and remain reserved. Settle and reconcile are idempotent; each retry attempt owns a reservation."
    },
    {
      "testCaseId": "Phase015:version-evidence",
      "command": "npm run test -- guarded-client evidence",
      "denominator": 1,
      "inputPath": "src/server/ai/guarded-client.ts",
      "outputPath": "docs/evidence/attempts/Phase015/attempt-12/version-evidence.json",
      "expected": "Every adapter attempt appends one AiOutputRecord with exact prompt/model/provider versions, trace and attempt numbers, hashes, status/error, duration, and token usage. Production rawOutput is null; prompt, user-sensitive text, credentials, authorization headers, and raw provider bodies never enter evidence or public errors."
    },
    {
      "testCaseId": "Phase015:kill-switch",
      "command": "npm run test -- ai-governance kill",
      "denominator": 1,
      "inputPath": "src/server/services/ai-governance-service.ts",
      "outputPath": "docs/evidence/attempts/Phase015/attempt-12/kill-switch.json",
      "expected": "Default and disabled kill states perform zero adapter calls before reservation. Authorized MOCK activation succeeds through the guarded client. LIVE requires environment admission and an ACTIVE database key. NONE sends no credential; REQUIRED without an ACTIVE key remains at zero egress. Restart does not turn a disabled switch back on."
    },
    {
      "testCaseId": "Phase015:mutation",
      "command": "npm run test -- ai-governance provider-registry guarded-client prompt-service",
      "denominator": 1,
      "inputPath": "tests/phase015/fixture.ts",
      "outputPath": "docs/evidence/attempts/Phase015/attempt-12/mutation.json",
      "expected": "In isolated temporary copies, removing the guarded-client entry point, activation/kill check, reservation CAS, or AbortSignal makes the corresponding fixed fixture red. Restoring the source makes the complete eight-scenario collection green. The mutation observation command itself exits zero."
    }
  ],
