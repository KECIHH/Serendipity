  "scope": "Extend the single Phase015 MockAiProvider with fixed failure fixtures, add the administrator AI debug workbench (page, three Route Handlers, AiDebugRun persistence and the AI_DEBUG durable task) and seal the M4 failure-injection matrix. Debug output is tracked by AiOutputRecord only; no formal plan version, travel record or ChatCommandEvent is written.",
  "implementationContextId": "codex-native-root-phase018-20260916",
  "phaseStartCommit": "de741a4580cdd2b80e28cb7075fa1160f2696783",
  "testMode": "full",
  "testModeReason": "A new Prisma model, migration, TaskKind, provider option and public admin surface change the shared guarded client, task dispatcher, provider registry and admin shell; affected selection is unavailable. Full discovered product regression plus the eight-fixture M4 matrix and five isolated negative controls are required.",
  "crossAttemptReuse": "disabled",
  "engineeringRegression": {
    "mode": "full",
    "baseCommit": "de741a4580cdd2b80e28cb7075fa1160f2696783",
    "fullCommand": "npm run test",
    "dedicatedCardCommand": "npm run test -- mock-provider ai-debug-api ai-e2e",
    "discovery": "vitest list --json; exact file/fullName equality, no skipped or zero tests"
  },
  "requiredCaseIds": [
    "Phase018:success",
    "Phase018:timeout",
    "Phase018:invalid-json",
    "Phase018:schema-mismatch",
    "Phase018:repair",
    "Phase018:stream-interruption",
    "Phase018:cost",
    "Phase018:authorization",
    "Phase018:negative-controls"
  ],
  "cases": [
    {
      "testCaseId": "Phase018:success",
      "command": "npm run test -- mock-provider ai-debug-api ai-e2e",
      "denominator": 1,
      "inputPath": "tests/phase018/fixtures.json",
      "outputPath": "docs/evidence/attempts/Phase018/attempt-25/success.json",
      "expected": "A fixed Mock success reaches SUCCEEDED through the persisted run with exactly one AiOutputRecord attempt (travelRecordId and commandId null, rawOutput null), zero formal plan writes and zero ChatCommandEvent rows."
    },
    {
      "testCaseId": "Phase018:timeout",
      "command": "npm run test -- mock-provider ai-debug-api ai-e2e",
      "denominator": 1,
      "inputPath": "tests/phase018/fixtures.json",
      "outputPath": "docs/evidence/attempts/Phase018/attempt-25/timeout.json",
      "expected": "A fixed Mock timeout fails the run with the structured PROVIDER_TIMEOUT code and a FAILED attempt, records no success summary and never emits a success event."
    },
    {
      "testCaseId": "Phase018:invalid-json",
      "command": "npm run test -- mock-provider ai-debug-api ai-e2e",
      "denominator": 1,
      "inputPath": "tests/phase018/fixtures.json",
      "outputPath": "docs/evidence/attempts/Phase018/attempt-25/invalid-json.json",
      "expected": "A truncated Mock body is classified INVALID_JSON only inside the ADMIN-authorized diagnostic payload and attempt classification; the public error projection stays PROVIDER_UNAVAILABLE and the database rawOutput stays null."
    },
    {
      "testCaseId": "Phase018:schema-mismatch",
      "command": "npm run test -- mock-provider ai-debug-api ai-e2e",
      "denominator": 1,
      "inputPath": "tests/phase018/fixtures.json",
      "outputPath": "docs/evidence/attempts/Phase018/attempt-25/schema-mismatch.json",
      "expected": "A well-formed but non-conforming Mock body is classified SCHEMA_MISMATCH, the attempt records parsedOk false and the run fails without a success summary."
    },
    {
      "testCaseId": "Phase018:repair",
      "command": "npm run test -- mock-provider ai-debug-api ai-e2e",
      "denominator": 1,
      "inputPath": "tests/phase018/fixtures.json",
      "outputPath": "docs/evidence/attempts/Phase018/attempt-25/repair.json",
      "expected": "A broken body is repaired through the frozen planner.repair_json Prompt using the same immutable NluContext, appending attempt 1 (INVALID_JSON) and attempt 2 (SUCCEEDED) with exact governance versions and no formal write."
    },
    {
      "testCaseId": "Phase018:stream-interruption",
      "command": "npm run test -- mock-provider ai-debug-api ai-e2e",
      "denominator": 1,
      "inputPath": "tests/phase018/fixtures.json",
      "outputPath": "docs/evidence/attempts/Phase018/attempt-25/stream-interruption.json",
      "expected": "Stream deltas stay transient (zero ChatCommandEvent and Outbox rows); a lost first response leaves the run resumable, a restarted worker completes it and GET recovers the identical final aggregate with zero Provider calls."
    },
    {
      "testCaseId": "Phase018:cost",
      "command": "npm run test -- mock-provider ai-debug-api ai-e2e",
      "denominator": 1,
      "inputPath": "tests/phase018/fixtures.json",
      "outputPath": "docs/evidence/attempts/Phase018/attempt-25/cost.json",
      "expected": "An exhausted shared NluContext token/cost budget fails the run with COST_LIMIT before any egress: zero Mock calls, zero attempts, zero formal writes."
    },
    {
      "testCaseId": "Phase018:authorization",
      "command": "npm run test -- mock-provider ai-debug-api ai-e2e",
      "denominator": 1,
      "inputPath": "tests/phase018/fixtures.json",
      "outputPath": "docs/evidence/attempts/Phase018/attempt-25/authorization.json",
      "expected": "Anonymous, USER, DISABLED, expired and stale-session callers are refused by the real requireAdmin guard with AUTH_REQUIRED/FORBIDDEN, zero AiDebugRun/DurableTask/TaskPayload writes and zero Mock calls; a foreign origin or missing CSRF is refused with 403."
    },
    {
      "testCaseId": "Phase018:negative-controls",
      "command": "node docs/phase-plans/verify-phase018.mjs --negative-controls",
      "denominator": 5,
      "inputPath": "tests/phase018/fixtures.json",
      "outputPath": "docs/evidence/attempts/Phase018/attempt-25/negative-controls.json",
      "expected": "Temporary removal of the admin guard, Mock determinism, strict schema parsing, the formal-write boundary or delta transience must fail the exact targeted assertion; restore bytes and rerun the eight fixtures."
    }
