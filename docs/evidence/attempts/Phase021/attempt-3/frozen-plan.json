      "testCaseId": "Phase021:missing",
      "command": "npm run test -- nlu/constraints nlu/missing-fields nlu/merge nlu/ask nlu/process",
      "denominator": 4,
      "inputPath": "tests/nlu/missing-fields.test.ts",
      "outputPath": "docs/evidence/attempts/Phase021/attempt-3/missing.json",
      "expected": "Blocking, normal and optional gaps follow the frozen readiness policy."
    },
    {
      "testCaseId": "Phase021:merge",
      "command": "npm run test -- nlu/constraints nlu/missing-fields nlu/merge nlu/ask nlu/process",
      "denominator": 8,
      "inputPath": "tests/nlu/merge.test.ts",
      "outputPath": "docs/evidence/attempts/Phase021/attempt-3/merge.json",
      "expected": "Patches keep the prior snapshot immutable and recalculate missing fields."
