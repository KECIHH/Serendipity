      "denominator": 3,
      "inputPath": "tests/nlu/ask.test.ts",
      "outputPath": "docs/evidence/attempts/Phase021/attempt-3/ask.json",
      "expected": "At most three natural questions are shown, with blocking fields first."
    },
    {
      "testCaseId": "Phase021:process",
      "command": "npm run test -- nlu/constraints nlu/missing-fields nlu/merge nlu/ask nlu/process",
      "denominator": 3,
      "inputPath": "tests/nlu/process.test.ts",
      "outputPath": "docs/evidence/attempts/Phase021/attempt-3/process.json",
      "expected": "One guarded pass merges a requirement and derives confirmation status."
