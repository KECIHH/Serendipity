  "issues": [
    {
      "id": "PHASE008-REVIEW-001",
      "priority": "P1",
      "title": "Final audit does not reject newly added untested files",
      "status": "RESOLVED",
      "originReviewPath": "docs/evidence/attempts/Phase008/attempt-2/preliminary-review.json",
      "originReviewHash": "5607bec002326dc6ff1e22d16ea5392e7bb3003ad81cc72b25f541514d7f9c36",
      "originalFinding": "The final audit recomputes hashes only for previously listed plan.sourcePaths. The working inventory and modification-scope scan run during quality only. Adding a new unlisted source/API file or an extra migration after quality and committing it with the artifact can leave every audited source hash unchanged; metadata then labels the new full artifact tree as testedTree."
    },
    {
      "id": "PHASE008-REVIEW-002",
      "priority": "P2",
      "title": "Setup failures are not automatically recorded as immutable attempts",
      "status": "RESOLVED",
      "originReviewPath": "docs/evidence/attempts/Phase008/attempt-2/preliminary-review.json",
      "originReviewHash": "5607bec002326dc6ff1e22d16ea5392e7bb3003ad81cc72b25f541514d7f9c36",
      "originalFinding": "The setup catch prints the error and sets exitCode but writes no attempt.json and preserves no partial command record. Attempt 1 was retained by the root agent separately. A later setup failure could otherwise be absent from the phase history; the existing-config success branch also returns without requiring the successful PostgreSQL setup receipt."
    },
    {
      "id": "PHASE008-REVIEW-003",
      "priority": "P2",
      "title": "Previous failure receipts can disappear without blocking final audit",
      "status": "RESOLVED",
      "originReviewPath": "docs/evidence/attempts/Phase008/attempt-2/preliminary-review.json",
      "originReviewHash": "5607bec002326dc6ff1e22d16ea5392e7bb3003ad81cc72b25f541514d7f9c36",
      "originalFinding": "Retry and audit bind only each previous frozen-plan file and its hash, not the corresponding failure attempt.json. Removing a prior failure receipt while retaining its frozen plan would still satisfy these checks; metadata inventories only the evidence files that remain."
    },
    {
      "id": "PHASE008-REVIEW-004",
      "priority": "P2",
      "title": "Migration generation accepts echoed or incomplete command records",
      "status": "RESOLVED",
      "originReviewPath": "docs/evidence/attempts/Phase008/attempt-2/preliminary-review.json",
      "originReviewHash": "5607bec002326dc6ff1e22d16ea5392e7bb3003ad81cc72b25f541514d7f9c36",
      "originalFinding": "The predicate only looks for a command containing --create-only, exitCode 0 and a falsy timedOut. Both an echo command and a record missing timeout/stdout/stderr were accepted by the extracted real function. The actual existing generation receipt is correct; the issue is its validator."
    },
    {
      "id": "PHASE008-REVIEW-005",
      "priority": "P2",
      "title": "Two records from the same shell satisfy dual-shell admission",
      "status": "RESOLVED",
      "originReviewPath": "docs/evidence/attempts/Phase008/attempt-2/preliminary-review.json",
      "originReviewHash": "5607bec002326dc6ff1e22d16ea5392e7bb3003ad81cc72b25f541514d7f9c36",
      "originalFinding": "The admission checks require two successful entries but do not bind their distinct shell identities. Replacing the second entry with a clone of PowerShell7 was accepted. The actual current preflight contains both required shells and is correct."
    },
    {
      "id": "PHASE008-REVIEW-006",
      "priority": "P2",
      "title": "Failure-chain completeness and inherited hashes are not enforced",
      "status": "RESOLVED",
      "originReviewPath": "docs/evidence/attempts/Phase008/attempt-5/failure-chain-review.json",
      "originReviewHash": "ba72b11e6c678610df1f52ac149da0d2f00e7b02f9d9d32733ef70b4376a5cba",
      "originalFinding": "The validator checks only entries that are present. An attempt-5 plan with all prior entries removed, one older entry omitted, or their order reversed is accepted. Retry also refreshes every previous failureHash without first validating inherited bindings. A changed older failure receipt can therefore be accepted after rebinding its hash in the newest plan even though historical frozen plans retain the original binding. The four acceptance gaps were reproduced without editing any file or database."
    }
  ],
