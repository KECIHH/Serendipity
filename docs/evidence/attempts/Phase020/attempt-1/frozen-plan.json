      "inputPath": "tests/nlu/travelers.test.ts",
      "outputPath": "docs/evidence/attempts/Phase020/attempt-1/travelers.json",
      "expected": "Parents do not prove elder age; couple, family and graduation counts stay consistent."
    },
    {
      "testCaseId": "Phase020:budget",
      "command": "npm run test -- nlu/travelers nlu/budget nlu/preferences nlu/parameter-calls",
      "denominator": 4,
      "inputPath": "tests/nlu/budget.test.ts",
      "outputPath": "docs/evidence/attempts/Phase020/attempt-1/budget.json",
      "expected": "Chinese amounts become canonical decimals and currency stays null unless explicit."
    },
    {
      "testCaseId": "Phase020:preferences",
      "command": "npm run test -- nlu/travelers nlu/budget nlu/preferences nlu/parameter-calls",
      "denominator": 4,
      "inputPath": "tests/nlu/preferences.test.ts",
      "outputPath": "docs/evidence/attempts/Phase020/attempt-1/preferences.json",
      "expected": "Interests normalize to the frozen vocabulary and avoid remains an array."
    },
    {
      "testCaseId": "Phase020:guarded-calls",
      "command": "npm run test -- nlu/travelers nlu/budget nlu/preferences nlu/parameter-calls",
      "denominator": 2,
      "inputPath": "tests/nlu/parameter-calls.test.ts",
      "outputPath": "docs/evidence/attempts/Phase020/attempt-1/guarded-calls.json",
      "expected": "The two required mixed sentences resolve through the guarded parameter prompt."
    },
    {
      "testCaseId": "Phase020:negative-controls",
      "command": "node docs/phase-plans/verify-phase020.mjs --negative-controls",
      "denominator": 3,
      "inputPath": "docs/phase-plans/verify-phase020.mjs",
      "outputPath": "docs/evidence/attempts/Phase020/attempt-1/negative-controls.json",
      "expected": "Amount, elder and avoid mutations each fail one targeted assertion before restoration."
    }
