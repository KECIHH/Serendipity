generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TravelStatus {
  DRAFT
  NEEDS_INFO
  PLANNED
  MODIFIED
  FINALIZED
  NEEDS_REVALIDATION
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageKind {
  TEXT
  STRUCTURED
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  phone                String?
  name                 String?
  avatarUrl            String?
  passwordHash         String
  role                 Role           @default(USER)
  status               UserStatus     @default(ACTIVE)
  sessionVersion       Int            @default(0)
  revision             Int            @default(0)
  lastLoginAt          DateTime?
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  updatedSystemConfigs SystemConfig[]
  travelRecords        TravelRecord[]
  auditLogs            AuditLog[]

  @@index([status])
}

model SystemConfig {
  id            String   @id @default(cuid())
  key           String   @unique
  valueJson     Json
  description   String
  group         String
  isPublic      Boolean  @default(false)
  revision      Int      @default(0)
  updatedBy     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  updatedByUser User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([group, key])
  @@index([updatedBy])
}

model TravelRecord {
  id              String        @id @default(cuid())
  userId          String?
  anonTokenHash   String?       @db.Char(64)
  title           String
  status          TravelStatus  @default(DRAFT)
  version         Int           @default(0)
  requirementJson Json?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  user            User?         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages        ChatMessage[]

  @@index([userId, createdAt, id])
  @@index([anonTokenHash, createdAt, id])
  @@index([status, updatedAt, id])
}

model ChatMessage {
  id               String          @id @default(cuid())
  travelRecordId   String
  role             MessageRole
  kind             ChatMessageKind
  content          String          @db.Text
  contentJson      Json?
  sequence         Int
  clientMessageId  String?
  replyToMessageId String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  travelRecord     TravelRecord    @relation(fields: [travelRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replyTo          ChatMessage?    @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies          ChatMessage[]   @relation("ChatMessageReplies")

  @@unique([travelRecordId, sequence])
  @@unique([travelRecordId, clientMessageId])
  @@index([replyToMessageId])
}

model AuditLog {
  id                 String   @id @default(cuid())
  actorId            String?
  actorEmailSnapshot String?  @db.VarChar(254)
  action             String   @db.VarChar(64)
  targetType         String   @db.VarChar(64)
  targetId           String?  @db.VarChar(128)
  requestId          String?  @db.VarChar(36)
  traceId            String?  @db.VarChar(36)
  detailJson         Json?
  ipHash             String?  @db.Char(64)
  userAgentSummary   String?  @db.VarChar(256)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  actor              User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@index([traceId])
}
