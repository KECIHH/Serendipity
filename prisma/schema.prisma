generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuthLoginAttemptStatus {
  RESERVED
  FAILED
  SUCCEEDED
  EXPIRED
}

enum AdminCommandStatus {
  PENDING
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
}

enum KeyRotationStage {
  PREPARING
  TESTING
  READY
  ACTIVATED
  ABORTED
}

enum TravelStatus {
  DRAFT
  NEEDS_INFO
  PLANNED
  MODIFIED
  FINALIZED
  NEEDS_REVALIDATION
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageKind {
  TEXT
  STRUCTURED
}

enum ChatCommandKind {
  CHAT_MESSAGE
  PLAN_DRAFT
}

enum ChatCommandStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  DELIVERED
}

enum ProviderMode {
  MOCK
  LIVE
}

enum CredentialRequirement {
  NONE
  REQUIRED
}

enum PromptModelActivationStatus {
  ACTIVE
  DISABLED
}

enum AiOutputStatus {
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiReservationStatus {
  RESERVED
  RECONCILING
  SETTLED
  RELEASED
}

enum AiSubmissionState {
  NOT_SENT
  MAY_HAVE_BEEN_SENT
  ACCEPTED
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  phone                     String?
  name                      String?
  avatarUrl                 String?
  passwordHash              String
  role                      Role                       @default(USER)
  status                    UserStatus                 @default(ACTIVE)
  sessionVersion            Int                        @default(0)
  revision                  Int                        @default(0)
  lastLoginAt               DateTime?
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  updatedSystemConfigs      SystemConfig[]
  travelRecords             TravelRecord[]
  auditLogs                 AuditLog[]
  authSessions              AuthSession[]
  adminCommandReceipts      AdminCommandReceipt[]
  promptVersions            PromptVersion[]
  modelDeployments          ModelDeployment[]
  planningPolicies          PlanningPolicyVersion[]
  promptActivations         PromptActivation[]
  promptModelActivations    PromptModelActivation[]
  planningPolicyActivations PlanningPolicyActivation[]

  @@index([status])
  @@index([createdAt, id])
  @@index([role, status, id])
}

model SystemConfig {
  id            String   @id @default(cuid())
  key           String   @unique
  valueJson     Json
  description   String
  group         String
  isPublic      Boolean  @default(false)
  revision      Int      @default(0)
  updatedBy     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  updatedByUser User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([group, key])
  @@index([updatedBy])
}

model TravelRecord {
  id              String           @id @default(cuid())
  userId          String?
  anonTokenHash   String?          @db.Char(64)
  title           String
  status          TravelStatus     @default(DRAFT)
  version         Int              @default(0)
  requirementJson Json?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages        ChatMessage[]
  commands        ChatCommand[]
  aiOutputRecords AiOutputRecord[]

  @@index([userId, createdAt, id])
  @@index([anonTokenHash, createdAt, id])
  @@index([status, updatedAt, id])
}

model ChatMessage {
  id               String          @id @default(cuid())
  travelRecordId   String
  role             MessageRole
  kind             ChatMessageKind
  content          String          @db.Text
  contentJson      Json?
  sequence         Int
  clientMessageId  String?
  commandId        String?
  replyToMessageId String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  travelRecord     TravelRecord    @relation(fields: [travelRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replyTo          ChatMessage?    @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies          ChatMessage[]   @relation("ChatMessageReplies")
  commandUser      ChatCommand?    @relation("CommandUserMessage")
  commandAssistant ChatCommand?    @relation("CommandAssistantMessage")
  command          ChatCommand?    @relation("CommandMessages", fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([travelRecordId, sequence])
  @@unique([travelRecordId, clientMessageId])
  @@index([replyToMessageId])
  @@index([commandId])
}

model AuditLog {
  id                 String   @id @default(cuid())
  actorId            String?
  actorEmailSnapshot String?  @db.VarChar(254)
  action             String   @db.VarChar(64)
  targetType         String   @db.VarChar(64)
  targetId           String?  @db.VarChar(128)
  requestId          String?  @db.VarChar(36)
  traceId            String?  @db.VarChar(36)
  detailJson         Json?
  ipHash             String?  @db.Char(64)
  userAgentSummary   String?  @db.VarChar(256)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  actor              User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@index([traceId])
}

model ApiKeyConfig {
  id                     String                  @id @default(cuid())
  name                   String
  provider               String
  encryptedKey           String                  @db.Text
  encryptionKeyId        String
  envelopeVersion        Int                     @default(1)
  keyFingerprint         String                  @unique @db.Char(64)
  status                 ApiKeyStatus            @default(ACTIVE)
  lastUsedAt             DateTime?               @db.Timestamptz(3)
  revokedAt              DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  revision               Int                     @default(0)
  oldRotationRuns        KeyRotationRun[]        @relation("OldRotationKey")
  newRotationRuns        KeyRotationRun[]        @relation("NewRotationKey")
  providerConfigVersions ProviderConfigVersion[]

  @@index([provider, status])
}

model AdminCommandReceipt {
  id                 String             @id @default(cuid())
  ownerUserId        String
  operationId        String             @db.VarChar(128)
  resourceId         String             @db.VarChar(128)
  idempotencyKeyHash String             @db.Char(64)
  requestHash        String             @db.Char(64)
  status             AdminCommandStatus @default(PENDING)
  responseJson       Json?
  errorCode          String?            @db.VarChar(64)
  attemptCount       Int                @default(0)
  availableAt        DateTime           @default(now()) @db.Timestamptz(3)
  leaseOwner         String?            @db.VarChar(128)
  leaseUntil         DateTime?          @db.Timestamptz(3)
  fencingToken       Int                @default(0)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?          @db.Timestamptz(3)
  expiresAt          DateTime           @db.Timestamptz(3)
  owner              User               @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  keyRotationRun     KeyRotationRun?
  task               DurableTask? @relation("ReceiptTask")

  @@unique([ownerUserId, operationId, resourceId, idempotencyKeyHash])
  @@index([status, availableAt, leaseUntil, id])
  @@index([expiresAt])
}

model KeyRotationRun {
  id                String              @id @default(cuid())
  receiptId         String              @unique
  oldKeyId          String
  newKeyId          String?
  candidateIdsJson  Json                @default("[]")
  referenceSetHash  String              @db.Char(64)
  baseRevisionsJson Json
  stage             KeyRotationStage    @default(PREPARING)
  checkpointJson    Json
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  receipt           AdminCommandReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  oldKey            ApiKeyConfig        @relation("OldRotationKey", fields: [oldKeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  newKey            ApiKeyConfig?       @relation("NewRotationKey", fields: [newKeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task              DurableTask?        @relation("RotationTask")

  @@index([oldKeyId])
  @@index([newKeyId])
  @@index([stage, updatedAt, id])
}

model AuthSession {
  id             String            @id @default(cuid())
  userId         String
  tokenHash      String            @unique @db.Char(64)
  audience       String            @db.VarChar(16)
  sessionVersion Int
  status         AuthSessionStatus @default(ACTIVE)
  issuedAt       DateTime          @db.Timestamptz(3)
  expiresAt      DateTime          @db.Timestamptz(3)
  lastSeenAt     DateTime?         @db.Timestamptz(3)
  revokedAt      DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, status, expiresAt, id])
  @@index([expiresAt])
}

model AuthLoginAttempt {
  id            String                 @id @default(cuid())
  scope         String                 @db.VarChar(16)
  ipHash        String                 @db.Char(64)
  accountHash   String                 @db.Char(64)
  status        AuthLoginAttemptStatus @default(RESERVED)
  reservedUntil DateTime               @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?              @db.Timestamptz(3)
  requestId     String                 @unique @db.VarChar(36)

  @@index([scope, ipHash, createdAt])
  @@index([scope, accountHash, createdAt])
  @@index([status, reservedUntil, id])
}

model PromptDefinition {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(128)
  purpose   String   @db.VarChar(256)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  versions        PromptVersion[]
  activation      PromptActivation?
  modelActivation PromptModelActivation?

  @@index([createdAt])
}

model PromptVersion {
  id                    String   @id @default(cuid())
  definitionId          String
  version               Int
  content               String   @db.Text
  contentHash           String   @db.Char(64)
  variablesJson         Json
  responseSchemaVersion Int
  createdById           String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  definition       PromptDefinition        @relation(fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy        User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  activations      PromptActivation[]
  modelActivations PromptModelActivation[]
  outputRecords    AiOutputRecord[]

  @@unique([definitionId, version])
  @@unique([definitionId, contentHash])
  @@unique([definitionId, id])
  @@index([createdAt])
}

model PromptActivation {
  definitionId      String   @id
  championVersionId String
  revision          Int      @default(0)
  updatedById       String?
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  definition      PromptDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  championVersion PromptVersion    @relation(fields: [definitionId, championVersionId], references: [definitionId, id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy       User?            @relation(fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([updatedById, updatedAt])
}

model ModelDeployment {
  id                  String   @default(cuid())
  configVersion       Int
  providerId          String
  providerModelName   String   @db.VarChar(128)
  paramsJson          Json
  capabilitiesJson    Json
  contextWindowTokens Int
  contentHash         String   @db.Char(64)
  createdById         String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  provider              ProviderConfigVersion   @relation(fields: [providerId, providerConfigVersion], references: [providerId, configVersion], onDelete: Restrict, onUpdate: Restrict)
  providerConfigVersion Int
  createdBy             User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  activations           PromptModelActivation[]
  outputRecords         AiOutputRecord[]

  @@id([id, configVersion])
  @@index([providerId, createdAt])
  @@index([createdById])
}

model ProviderConfigVersion {
  providerId            String                @default(cuid())
  configVersion         Int
  mode                  ProviderMode
  baseUrl               String                @db.VarChar(512)
  capabilities          Json
  timeoutMs             Int
  maxRetries            Int
  quotaTokensPerDay     Int
  costLimitPerDay       Decimal               @db.Decimal(18, 8)
  region                String                @db.VarChar(64)
  locale                String                @db.VarChar(35)
  credentialRequirement CredentialRequirement
  secretRef             String?
  contentHash           String                @db.Char(64)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)

  secretRefKey  ApiKeyConfig?           @relation(fields: [secretRef], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deployments   ModelDeployment[]
  activations   PromptModelActivation[]
  outputRecords AiOutputRecord[]

  @@id([providerId, configVersion])
  @@index([mode, createdAt])
  @@index([secretRef])
}

model PromptModelActivation {
  definitionId            String                      @id
  promptVersionId         String
  deploymentId            String
  deploymentConfigVersion Int
  providerId              String
  providerConfigVersion   Int
  status                  PromptModelActivationStatus @default(DISABLED)
  revision                Int                         @default(0)
  updatedById             String?
  updatedAt               DateTime                    @updatedAt @db.Timestamptz(3)

  definition    PromptDefinition      @relation(fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  promptVersion PromptVersion         @relation(fields: [definitionId, promptVersionId], references: [definitionId, id], onDelete: Restrict, onUpdate: Restrict)
  deployment    ModelDeployment       @relation(fields: [deploymentId, deploymentConfigVersion], references: [id, configVersion], onDelete: Restrict, onUpdate: Restrict)
  provider      ProviderConfigVersion @relation(fields: [providerId, providerConfigVersion], references: [providerId, configVersion], onDelete: Restrict, onUpdate: Restrict)
  updatedBy     User?                 @relation(fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([status, updatedAt])
  @@index([updatedById, updatedAt])
  @@index([providerId, providerConfigVersion])
}

model PlanningPolicyVersion {
  id          String   @id @default(cuid())
  version     Int      @unique
  contentJson Json
  contentHash String   @db.Char(64)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  createdBy  User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  activation PlanningPolicyActivation?
  outputs    AiOutputRecord[]

  @@index([createdAt])
}

model PlanningPolicyActivation {
  policyKey       String   @id @db.VarChar(128)
  activeVersionId String   @unique
  revision        Int      @default(0)
  updatedById     String?
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  activeVersion PlanningPolicyVersion @relation(fields: [activeVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy     User?                 @relation(fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
}

model AiOutputRecord {
  id                      String         @id @default(cuid())
  travelRecordId          String?
  commandId               String?
  traceId                 String         @db.VarChar(128)
  attemptNo               Int
  promptVersionId         String
  activationRevision      Int
  planningPolicyVersionId String
  deploymentId            String
  deploymentConfigVersion Int
  providerId              String
  providerConfigVersion   Int
  inputHash               String         @db.Char(64)
  outputHash              String         @db.Char(64)
  rawOutput               String?        @db.Text
  parsedOk                Boolean
  status                  AiOutputStatus
  errorCode               String?        @db.VarChar(64)
  errorMessage            String?        @db.VarChar(256)
  inputTokens             Int?
  outputTokens            Int?
  durationMs              Int
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)

  travelRecord   TravelRecord?         @relation(fields: [travelRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  command        ChatCommand?          @relation(fields: [commandId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  promptVersion  PromptVersion         @relation(fields: [promptVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planningPolicy PlanningPolicyVersion @relation(fields: [planningPolicyVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deployment     ModelDeployment       @relation(fields: [deploymentId, deploymentConfigVersion], references: [id, configVersion], onDelete: Restrict, onUpdate: Restrict)
  provider       ProviderConfigVersion @relation(fields: [providerId, providerConfigVersion], references: [providerId, configVersion], onDelete: Restrict, onUpdate: Restrict)

  @@unique([traceId, attemptNo])
  @@index([createdAt])
  @@index([commandId])
  @@index([travelRecordId, createdAt])
}

model AiUsageReservation {
  id                String              @id @default(cuid())
  bucketKey         String              @db.VarChar(128)
  traceId           String              @db.VarChar(128)
  attemptNo         Int
  estimatedTokens   Int
  estimatedCost     Decimal             @db.Decimal(18, 8)
  actualTokens      Int?
  actualCost        Decimal?            @db.Decimal(18, 8)
  status            AiReservationStatus @default(RESERVED)
  submissionState   AiSubmissionState   @default(NOT_SENT)
  providerRequestId String?             @db.VarChar(128)
  expiresAt         DateTime            @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  settledAt         DateTime?           @db.Timestamptz(3)

  @@unique([traceId, attemptNo])
  @@index([bucketKey, status, createdAt])
  @@index([expiresAt, status])
}

model ChatCommand {
  id                   String            @id @default(cuid())
  travelRecordId       String
  ownerKeyHash         String            @db.Char(64)
  kind                 ChatCommandKind
  idempotencyKeyHash   String            @db.Char(64)
  requestHash          String            @db.Char(64)
  payloadRef           String            @db.VarChar(128)
  payloadSchemaVersion Int
  status               ChatCommandStatus @default(PENDING)
  userMessageId        String
  assistantMessageId   String?
  traceId              String            @db.VarChar(128)
  errorCode            String?           @db.VarChar(64)
  errorMessage         String?           @db.VarChar(256)
  startedAt            DateTime?         @db.Timestamptz(3)
  completedAt          DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  travelRecord     TravelRecord        @relation(fields: [travelRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userMessage      ChatMessage         @relation("CommandUserMessage", fields: [userMessageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assistantMessage ChatMessage?        @relation("CommandAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  events           ChatCommandEvent[]
  idempotency      CommandIdempotency?
  task             DurableTask?       @relation("CommandTask")
  outputs          AiOutputRecord[]
  messages         ChatMessage[] @relation("CommandMessages")

  @@unique([userMessageId])
  @@unique([assistantMessageId])
  @@unique([ownerKeyHash, kind, idempotencyKeyHash])
  @@index([ownerKeyHash, kind, status, createdAt])
  @@index([travelRecordId, status, createdAt])
  @@index([kind, status, createdAt])
}

model ChatCommandEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique @db.VarChar(36)
  sequence       Int
  aggregateId    String   @db.VarChar(128)
  traceId        String   @db.VarChar(128)
  type           String   @db.VarChar(64)
  status         String   @db.VarChar(32)
  occurredAt     DateTime @db.Timestamptz(3)
  payloadVersion Int
  payloadJson    Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  command ChatCommand @relation(fields: [aggregateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([aggregateId, sequence])
  @@index([aggregateId, sequence])
}

model CommandIdempotency {
  id                 String          @id @default(cuid())
  ownerKeyHash       String          @db.Char(64)
  kind               ChatCommandKind
  idempotencyKeyHash String          @db.Char(64)
  requestHash        String          @db.Char(64)
  commandId          String?         @unique
  responseJson       Json?
  status             ChatCommandStatus
  expiresAt          DateTime        @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  command ChatCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([ownerKeyHash, kind, idempotencyKeyHash])
  @@index([expiresAt])
}

model DurableTask {
  id                   String     @id @default(cuid())
  kind                 String     @db.VarChar(64)
  aggregateId          String     @db.VarChar(128)
  payloadHash          String     @db.Char(64)
  payloadRef           String     @db.VarChar(128)
  payloadSchemaVersion Int
  status               TaskStatus @default(PENDING)
  attemptCount         Int        @default(0)
  maxAttempts          Int
  availableAt          DateTime   @default(now()) @db.Timestamptz(3)
  leaseOwner           String?    @db.VarChar(128)
  leaseUntil           DateTime?  @db.Timestamptz(3)
  fencingToken         Int        @default(0)
  checkpointJson       Json
  resultRef            String?    @db.VarChar(128)
  errorCategory        String?    @db.VarChar(64)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(3)

  commandId     String?       @unique
  rotationRunId String?       @unique
  adminReceiptId String?      @unique
  command       ChatCommand?    @relation("CommandTask", fields: [commandId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  keyRotation   KeyRotationRun? @relation("RotationTask", fields: [rotationRunId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  adminReceipt  AdminCommandReceipt? @relation("ReceiptTask", fields: [adminReceiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([kind, aggregateId])
  @@index([status, availableAt, leaseUntil, id])
  @@index([leaseOwner, fencingToken])
  @@index([commandId])
  @@index([rotationRunId])
}

model TaskPayload {
  id                String   @id @default(cuid())
  ownerKeyHash      String   @db.Char(64)
  schemaVersion     Int
  ciphertext        String   @db.Text
  encryptionKeyId   String
  contentHash       String   @db.Char(64)
  expiresAt         DateTime @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([ownerKeyHash, expiresAt])
  @@index([expiresAt])
}

model Outbox {
  id           String      @id @default(cuid())
  aggregateId  String      @db.VarChar(128)
  type         String      @db.VarChar(64)
  eventId      String      @unique @db.VarChar(36)
  payloadHash  String      @db.Char(64)
  payloadJson  Json
  status       OutboxStatus @default(PENDING)
  attemptCount Int         @default(0)
  availableAt  DateTime    @default(now()) @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  publishedAt  DateTime?   @db.Timestamptz(3)

  @@index([status, availableAt, id])
  @@index([aggregateId])
}
