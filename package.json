{
  "name": "serendipity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx scripts/auth-server.mjs --dev",
    "build": "next build",
    "start": "node --import tsx scripts/auth-server.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify:phase003": "node scripts/verify-phase003.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"*.{js,mjs,cjs,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"*.{js,mjs,cjs,ts,json}\"",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "0.544.0",
    "next": "15.5.24",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tr46": "6.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/tr46": "5.0.1",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "shadcn": "3.2.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.19.0",
    "npm": "11.7.0"
  },
  "packageManager": "npm@11.7.0",
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
