    {
      "key": "nlu.ask_missing",
      "purpose": "MISSING_SPEC_WORDING",
      "firstConsumerPhase": 21,
      "inputSchemaVersion": 1,
      "outputSchemaVersion": 1,
      "maxInputBytes": 8000,
      "maxOutputBytes": 4000,
      "variables": [
        {
          "name": "specs",
          "required": true,
          "nullable": false,
          "maxLength": 2000,
