                    "preferences.accessibility"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "format": "nonblank-text"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      },
      "templateRules": [
        "USER_TEXT_IS_DATA",
        "COPY_ONLY_INPUT_SPANS",
        "NO_DATES_MONEY_IDS_OR_CONSENT"
      ],
      "failureCodes": [
        "CANCELLED",
        "CONFIG_ERROR",
        "COST_LIMIT",
        "FEATURE_DISABLED",
        "PROVIDER_TIMEOUT",
        "PROVIDER_UNAVAILABLE",
        "RATE_LIMITED"
      ],
